# .env.example — copy to .env and fill in real values
# API Keys
NEWS_API_KEY=7572e05d9c1440a9887c595d6019bf7b
OPENSKY_USERNAME=your_opensky_username # Optional — increases rate limit
OPENSKY_PASSWORD=your_opensky_password
# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/geoair
DATABASE_URL_SYNC=postgresql://geoair:password@localhost:5432/geoair
# Security
SECRET_KEY=generate_a_long_random_string_here_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Application
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# NLP
NLP_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
SPACY_MODEL=en_core_web_lg
# Ingestion intervals (seconds)
NEWS_POLL_INTERVAL=60
FLIGHT_POLL_INTERVAL=10
REDIS_URL=redis://localhost:6379/0